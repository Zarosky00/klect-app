# dependencies
node_modules/
.pnp
.pnp.js

# next
web/.next/
web/out/
web/next-env.d.ts

# flutter / dart
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
*.iml

# env / secrets — never commit these
.env
.env.*
!.env.example
**/service-account*.json
firebase-service-account.json

# Firebase app config — scoped to the app's package/bundle id by Google, but
# still project-specific. Each dev/CI environment should fetch its own via
# `firebase_get_sdk_config` (Firebase MCP) rather than share one committed copy.
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# build output
dist/
coverage/
*.tsbuildinfo

# release binaries — distributed as GitHub release assets, never in git
web/public/downloads/
*.apk
.release-verify-*

# Supabase CLI link/cache state is machine-local.
supabase/.temp/

# JVM crash dumps
hs_err_pid*.log

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
