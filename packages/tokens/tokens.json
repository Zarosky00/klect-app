{
  "$meta": {
    "name": "Klect Design Tokens",
    "system": "Editorial Noir",
    "version": "1.0.0",
    "note": "SINGLE SOURCE OF TRUTH. Run `node build.mjs` to regenerate mobile/lib/design/tokens.g.dart and web/src/styles/tokens.g.css. Never hand-edit generated files. Never hardcode a value that lives here.",
    "rationale": {
      "dark_first": "Curation reads as gallery. A near-black graphite base (#0A0B0E, not #000) avoids OLED halation around light text while keeping true-black battery behaviour on most pixels.",
      "depth_by_surface": "Elevation is expressed by stepping the surface ramp, not by stacking shadows. Shadows are used once, softly, for floating chrome only. This is what keeps it from looking like Material 2.",
      "accent_60_30_10": "60% neutral surfaces, 30% supporting neutrals/text, 10% oxblood accent. Oxblood (wine cellar, leather binding, archive stamp) is deep and desaturated where Pinterest's red is loud and X's blue is cold — the brand stays ownable. Accent is always a FLAT fill: never in a gradient.",
      "action_colors_are_semantic": "Like=rose, Save=oxblood, Repost=mint. A user learns three colours once and never re-reads an icon. semantic.warning stays amber — it is a warning colour, not brand."
    }
  },

  "color": {
    "dark": {
      "bg":            { "base": "#0A0B0E", "sunken": "#06070A" },
      "surface": {
        "1": "#101218",
        "2": "#171A22",
        "3": "#1F232D",
        "4": "#282D39",
        "scrim": "#00000099",
        "glass": "#12141Ac9"
      },
      "border": { "subtle": "#20242E", "default": "#2A2F3B", "strong": "#3A4150", "focus": "#BE4450" },
      "text": {
        "primary":   "#F5F6F8",
        "secondary": "#A5ACBA",
        "tertiary":  "#717A8C",
        "disabled":  "#4A5162",
        "inverse":   "#0A0B0E",
        "onAccent":  "#FFF6EC"
      },
      "accent": {
        "default": "#A6323F",
        "hover":   "#BE4450",
        "press":   "#8C2A35",
        "subtle":  "#A6323F1f",
        "ring":    "#A6323F66"
      },
      "action": {
        "like":    "#FF4D6D",
        "likeSubtle":  "#FF4D6D1f",
        "save":    "#A6323F",
        "saveSubtle":  "#A6323F1f",
        "repost":  "#2DD4A7",
        "repostSubtle": "#2DD4A71f",
        "comment": "#4C9AFF",
        "commentSubtle": "#4C9AFF1f",
        "share":   "#A5ACBA"
      },
      "semantic": {
        "success": "#2DD4A7",
        "warning": "#F0B429",
        "danger":  "#FF5A5F",
        "dangerSubtle": "#FF5A5F1f",
        "info":    "#4C9AFF"
      },
      "match": { "low": "#6E7688", "mid": "#4C9AFF", "high": "#2DD4A7", "peak": "#BE4450" },
      "skeleton": { "base": "#171A22", "shimmer": "#22262F" }
    },

    "light": {
      "bg":            { "base": "#FBFBFC", "sunken": "#F2F3F5" },
      "surface": {
        "1": "#FFFFFF",
        "2": "#F7F8FA",
        "3": "#F0F1F4",
        "4": "#E7E9EE",
        "scrim": "#0A0B0E80",
        "glass": "#FFFFFFcc"
      },
      "border": { "subtle": "#EBECF0", "default": "#DFE1E6", "strong": "#C1C7D0", "focus": "#7C2531" },
      "text": {
        "primary":   "#0F1116",
        "secondary": "#525A69",
        "tertiary":  "#6B7485",
        "disabled":  "#A9B0BD",
        "inverse":   "#FFFFFF",
        "onAccent":  "#FFF6EC"
      },
      "accent": {
        "default": "#7C2531",
        "hover":   "#6E1F2A",
        "press":   "#591923",
        "subtle":  "#7C253114",
        "ring":    "#7C253159"
      },
      "action": {
        "like":    "#E01B47",
        "likeSubtle":  "#E01B4714",
        "save":    "#7C2531",
        "saveSubtle":  "#7C253114",
        "repost":  "#0C8465",
        "repostSubtle": "#0C846514",
        "comment": "#0B5CD5",
        "commentSubtle": "#0B5CD514",
        "share":   "#525A69"
      },
      "semantic": {
        "success": "#0C8465",
        "warning": "#976C06",
        "danger":  "#D91E22",
        "dangerSubtle": "#D91E2214",
        "info":    "#0B5CD5"
      },
      "match": { "low": "#6B7485", "mid": "#0B5CD5", "high": "#0C8465", "peak": "#7C2531" },
      "skeleton": { "base": "#F0F1F4", "shimmer": "#E7E9EE" }
    }
  },

  "typography": {
    "family": {
      "display": "Fraunces",
      "sans": "Instrument Sans",
      "mono": "JetBrains Mono"
    },
    "note": "Display serif (Fraunces, variable: opsz/SOFT/WONK) is used ONLY for collection/subcollection titles and empty-state headlines — that editorial contrast is the whole personality. Everything else is Instrument Sans. Weights 450/550/650 are exact variable-font positions (FontVariation on mobile, numeric weight on web), never rounded to static hundreds. Counts use tabular figures so they never reflow when a like lands.",
    "scale": {
      "display1":  { "size": 44, "lineHeight": 48, "weight": 400, "family": "display", "tracking": -0.6 },
      "display2":  { "size": 34, "lineHeight": 40, "weight": 400, "family": "display", "tracking": -0.4 },
      "display3":  { "size": 27, "lineHeight": 34, "weight": 400, "family": "display", "tracking": -0.2 },
      "title1":    { "size": 22, "lineHeight": 28, "weight": 650, "family": "sans", "tracking": -0.3 },
      "title2":    { "size": 19, "lineHeight": 25, "weight": 650, "family": "sans", "tracking": -0.2 },
      "title3":    { "size": 17, "lineHeight": 23, "weight": 600, "family": "sans", "tracking": -0.1 },
      "body":      { "size": 15, "lineHeight": 22, "weight": 400, "family": "sans", "tracking": 0 },
      "bodyStrong":{ "size": 15, "lineHeight": 22, "weight": 550, "family": "sans", "tracking": 0 },
      "callout":   { "size": 14, "lineHeight": 20, "weight": 450, "family": "sans", "tracking": 0 },
      "label":     { "size": 13, "lineHeight": 18, "weight": 550, "family": "sans", "tracking": 0.1 },
      "caption":   { "size": 12, "lineHeight": 16, "weight": 450, "family": "sans", "tracking": 0.15 },
      "micro":     { "size": 11, "lineHeight": 14, "weight": 600, "family": "sans", "tracking": 0.4 },
      "count":     { "size": 13, "lineHeight": 18, "weight": 600, "family": "sans", "tracking": 0, "tabular": true }
    }
  },

  "space": {
    "note": "4pt base grid. Never use a value outside this ramp.",
    "0": 0, "px": 1, "0_5": 2, "1": 4, "1_5": 6, "2": 8, "2_5": 10,
    "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32,
    "10": 40, "12": 48, "14": 56, "16": 64, "20": 80, "24": 96
  },

  "radius": {
    "none": 0, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 28, "3xl": 36, "full": 999
  },

  "border": { "hairline": 0.5, "thin": 1, "thick": 2, "focus": 2 },

  "elevation": {
    "note": "Depth is surface-ramp first. These are for genuinely floating chrome only: bottom bar, FAB, sheets, popovers.",
    "none":  { "y": 0, "blur": 0,  "spread": 0, "color": "#00000000" },
    "low":   { "y": 1, "blur": 3,  "spread": 0, "color": "#0000001f" },
    "mid":   { "y": 4, "blur": 14, "spread": -2, "color": "#00000033" },
    "high":  { "y": 12, "blur": 32, "spread": -6, "color": "#00000047" },
    "glow":  { "y": 0, "blur": 24, "spread": -4, "color": "#A6323F33" }
  },

  "motion": {
    "note": "Two rules: (1) anything the finger drives is a spring, anything the system drives is a curve. (2) Nothing exceeds 480ms — premium reads as immediate, not slow.",
    "duration": {
      "instant": 90,
      "fast": 140,
      "base": 200,
      "medium": 280,
      "slow": 360,
      "deliberate": 480
    },
    "curve": {
      "standard":   [0.2, 0.0, 0.0, 1.0],
      "decelerate": [0.05, 0.7, 0.1, 1.0],
      "accelerate": [0.3, 0.0, 0.8, 0.15],
      "emphasized": [0.16, 1.0, 0.3, 1.0],
      "overshoot":  [0.34, 1.56, 0.64, 1.0],
      "linear":     [0.0, 0.0, 1.0, 1.0]
    },
    "spring": {
      "snappy":  { "stiffness": 420, "damping": 32, "mass": 1 },
      "gentle":  { "stiffness": 220, "damping": 26, "mass": 1 },
      "bouncy":  { "stiffness": 380, "damping": 20, "mass": 1 },
      "sheet":   { "stiffness": 300, "damping": 30, "mass": 1 }
    },
    "stagger": { "grid": 26, "list": 34, "max": 8 }
  },

  "layout": {
    "note": "Masonry column counts by breakpoint — mobile and web must agree so a shared link looks like the same product.",
    "breakpoint": { "xs": 0, "sm": 480, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1600 },
    "masonryColumns": { "xs": 2, "sm": 2, "md": 3, "lg": 4, "xl": 5, "2xl": 6 },
    "masonryGutter": 10,
    "contentMaxWidth": 1320,
    "readableMaxWidth": 680,
    "tapTargetMin": 44,
    "bottomBarHeight": 60,
    "topBarHeight": 52
  },

  "opacity": { "disabled": 0.38, "pressed": 0.72, "hover": 0.86, "veil": 0.6, "ghost": 0.08 },

  "blur": { "chrome": 24, "sheet": 32, "spoiler": 40 },

  "aspect": {
    "note": "Media is never cropped in the closeup. In the grid, extreme ratios are clamped so one tall image can't own the viewport.",
    "gridMin": 0.62,
    "gridMax": 1.6,
    "cover": 1.0,
    "banner": 3.0
  },

  "z": { "base": 0, "raised": 10, "sticky": 100, "chrome": 200, "sheet": 300, "modal": 400, "toast": 500, "immersive": 600 }
}
